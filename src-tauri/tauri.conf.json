{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rift Companion",
  "version": "0.1.3",
  "identifier": "com.riftcompanion.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Rift Companion",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://ddragon.leagueoflegends.com https://raw.communitydragon.org https://opgg-static.akamaized.net https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ddragon.leagueoflegends.com http://127.0.0.1:* https://127.0.0.1:* ws://127.0.0.1:* wss://127.0.0.1:* http: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SaamIsHere/Rift-Companion/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBRUNBNjRCREIxQzlCNjYKUldSbW14emJTNmJzMm1STWI5aWFHRUtUZ0tjUHBWY0FzeEU5NVQxeStVcG5aQmtBZnVBNS96dnkK"
    }
  }
}
