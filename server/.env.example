# Rift Companion NAS Server Configuration

# Pre-shared secret key that friends' desktop apps send via X-Rift-Key header
RIFT_API_KEY=your-friends-secret-api-key-here

# Admin key required to trigger manual crawls (/api/refresh, /api/check-patch)
RIFT_ADMIN_KEY=your-secure-admin-secret-key-here

# Optional: Cloudflare Zero Trust Tunnel Token (for persistent named tunnels)
# If left empty, cloudflared automatically starts a free Quick Tunnel (trycloudflare.com)
TUNNEL_TOKEN=
